# =============================================================================
# PRODUCTION ENVIRONMENT VARIABLES — VPS EASYPANEL
# =============================================================================
# Salin file ini dan isi nilainya di EasyPanel → App → Environment Variables
# JANGAN commit file ini ke Git!
# =============================================================================

# Node Environment
NODE_ENV=production
PORT=5000

# Database (gunakan internal connection string dari EasyPanel)
# Format: postgres://USER:PASSWORD@SERVICE_NAME:5432/DB_NAME
DATABASE_URL=postgres://retribusi_user:GANTI_PASSWORD@retribusi-db:5432/retribusi_prod

# JWT — WAJIB diganti dengan string random panjang (min 32 karakter)
# Generate: openssl rand -base64 32
JWT_SECRET=GANTI_DENGAN_RANDOM_STRING_MINIMAL_32_KARAKTER
JWT_EXPIRES_IN=8h

# Bcrypt
BCRYPT_ROUNDS=12

# Session — WAJIB diganti, berbeda dari JWT_SECRET
SESSION_SECRET=GANTI_DENGAN_RANDOM_STRING_LAIN

# Frontend URL (domain yang dipakai di EasyPanel, termasuk https://)
# Digunakan untuk CORS whitelist
FRONTEND_URL=https://retribusi.yourdomain.com

# File Upload
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=application/pdf,image/jpeg,image/png
