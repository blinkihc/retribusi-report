    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.6",
    "drizzle-orm": "^0.44.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "framer-motion": "^12.23.24",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.553.0",
    "multer": "^2.0.2",
    "pdfkit": "^0.17.2",
    "postgres": "^3.4.7",
    "puppeteer": "^24.30.0",
    "react": "^18.3.1",
    "react-day-picker": "^9.11.2",
    "react-dom": "^18.3.1",
    "react-router": "^7.9.5",
